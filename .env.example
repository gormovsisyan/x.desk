# --- phase 1-2 (posts lane + plan/loop) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# cli = claude -p on a Claude subscription (local mode, default)
# api = Messages API — requires ANTHROPIC_API_KEY
WRITER=cli
# ANTHROPIC_API_KEY=          # WRITER=api only. with WRITER=cli the bot refuses to start if this is set.
# CLAUDE_BIN=/Users/you/.local/bin/claude   # only if `claude` is not on PATH
# CLI_SANDBOX_DIR=/Users/you/xdesk/sandbox  # empty cwd for claude -p runs (default ~/xdesk/sandbox; no ~ expansion here)

MODEL_WRITE=claude-fable-5
NPM_PACKAGES=your-package,another-package
GITHUB_REPOS=you/your-repo
# REPO_PATHS=/abs/path/to/your-repo,/abs/path/other-repo   # friday recap git material (cli writer only)
TZ=UTC
SLOTS=18:00,22:00
DB_PATH=./data/xdesk.sqlite

# --- phases 3-4 (not used yet) ---
MODEL_FILTER=claude-haiku-4-5-20251001
# MODEL_REPLY=claude-sonnet-5   # if the weekly allowance gets tight (phase 3)
X_BEARER_TOKEN=
X_LIST_ID=
X_MY_USER_ID=
ACTIVE_HOURS=17:00-02:00
QUIET_HOURS=02:00-09:00
DAILY_REPLY_CAP=20
